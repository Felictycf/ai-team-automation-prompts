{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "任务拆解模板",
  "description": "用于将复杂任务拆分为可管理子任务并标注依赖与资源分配的 JSON Schema",
  "type": "object",
  "required": ["task_id", "title", "description", "subtasks"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "主任务唯一标识",
      "pattern": "^[A-Z0-9]+-[0-9]{3,}$",
      "example": "TASK-001"
    },
    "title": {
      "type": "string",
      "description": "主任务的简洁标题",
      "minLength": 5,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "description": "任务目标与业务背景描述",
      "minLength": 10
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "任务优先级",
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "blocked", "on_hold", "completed"],
      "description": "当前状态",
      "default": "not_started"
    },
    "estimated_duration": {
      "type": "object",
      "description": "任务预计耗时",
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": ["hours", "days", "weeks"]
        }
      }
    },
    "owner": {
      "type": "object",
      "description": "任务责任人",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "subtasks": {
      "type": "array",
      "description": "子任务列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subtask_id", "title", "description"],
        "properties": {
          "subtask_id": {
            "type": "string",
            "description": "子任务唯一标识",
            "pattern": "^[A-Z0-9]+-[0-9]{3,}-[0-9]{2,}$",
            "example": "TASK-001-01"
          },
          "title": {
            "type": "string",
            "description": "子任务标题",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "description": "子任务需要完成的工作"
          },
          "acceptance_criteria": {
            "type": "array",
            "description": "子任务的验收条件",
            "items": {
              "type": "string"
            }
          },
          "estimated_hours": {
            "type": "number",
            "minimum": 0,
            "description": "完成该子任务预计小时数"
          },
          "assigned_to": {
            "type": "string",
            "description": "负责人姓名或 ID"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "blocked", "on_hold", "completed"],
            "default": "not_started"
          },
          "dependencies": {
            "type": "array",
            "description": "必须先完成的子任务 ID",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "description": "便于筛选的标签",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "description": "阻塞项及其状态",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "resolution": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["critical", "high", "medium", "low"]
                }
              }
            }
          },
          "resources_required": {
            "type": "array",
            "description": "子任务所需资源",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["tool", "access", "documentation", "data", "other"]
                },
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "主任务依赖的外部任务或条件",
      "items": {
        "type": "string"
      }
    },
    "resources_required": {
      "type": "array",
      "description": "主任务整体所需资源",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["tool", "access", "documentation", "data", "budget", "infrastructure"]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    },
    "success_metrics": {
      "type": "array",
      "description": "衡量任务成功的指标",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "measurement": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "任务创建时间"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "最近更新时间"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "预计完成日期"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "task_id": "TASK-001",
      "title": "实现用户认证系统",
      "description": "为应用构建一套完整的用户认证与授权能力",
      "priority": "high",
      "status": "in_progress",
      "estimated_duration": {
        "value": 2,
        "unit": "weeks"
      },
      "owner": {
        "name": "李晓明",
        "email": "liming@example.com",
        "role": "后端负责人"
      },
      "subtasks": [
        {
          "subtask_id": "TASK-001-01",
          "title": "设计认证数据库 Schema",
          "description": "创建用户、会话、凭据相关数据表",
          "acceptance_criteria": [
            "Schema 已文档化",
            "符合安全最佳实践",
            "通过评审"
          ],
          "estimated_hours": 8,
          "assigned_to": "王珊",
          "status": "completed",
          "tags": ["database", "backend"],
          "resources_required": [
            {
              "type": "tool",
              "description": "数据库建模工具"
            }
          ]
        },
        {
          "subtask_id": "TASK-001-02",
          "title": "实现认证 API 接口",
          "description": "构建登录、登出、刷新 Token 的 REST 接口",
          "acceptance_criteria": [
            "全部接口实现",
            "补齐单元测试",
            "完成 API 文档"
          ],
          "estimated_hours": 16,
          "assigned_to": "李晓明",
          "status": "in_progress",
          "dependencies": ["TASK-001-01"],
          "tags": ["backend", "api"]
        }
      ],
      "due_date": "2025-12-20",
      "created_at": "2025-12-06T09:00:16Z"
    }
  ]
}
